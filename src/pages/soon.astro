---
// Temporary landing page. Standalone on purpose: it does not use
// Base.astro, so it carries none of the site's header, menu, transitions
// or GSAP stack. Styling lives in /assets/css/landing.css and motion in
// /assets/js/landing.js (the pixel title and boot logo are drawn on a
// canvas there; the <h1> stays in the DOM for screen readers and no-JS).
// To make it live, render this page as the home page — see README.
const FAVICON =
  "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%23050508'/%3E%3Cpath d='M8 7h12v2h2v2h2v10h-2v2h-2v2H8z M12 11v10h6v-2h2v-6h-2v-2z' fill='%23eaf6ff' fill-rule='evenodd'/%3E%3C/svg%3E";

const SEGMENTS = 24;
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>Dayne.online</title>
    <meta name="description" content="Photographs and writing by Dayne. Coming soon." />
    <meta name="robots" content="noindex" />
    <meta property="og:title" content="Dayne.online" />
    <meta property="og:description" content="Photographs and writing by Dayne. Coming soon." />
    <link rel="icon" href={FAVICON} />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#050508" />

    <script is:inline>
    (function () {
        var d = document.documentElement;
        d.classList.add("js");
        // Safety net: if landing.js never boots, fall back to the static page.
        setTimeout(function () { if (!window.__landing) d.classList.remove("js"); }, 3000);
    })();
    </script>

    <link rel="preload" href="/assets/fonts/silkscreen-normal-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/assets/css/fonts.css" />
    <link rel="stylesheet" href="/assets/css/landing.css" />
</head>
<body>
    <canvas class="screen" aria-hidden="true" data-screen></canvas>

    <div class="loader" aria-hidden="true" data-loader>
        <span class="loader-label">Boot // dayne.online</span>
        <div class="loader-bar">
            {Array.from({ length: SEGMENTS }, () => <i></i>)}
        </div>
        <span class="loader-pct" data-pct>000%</span>
    </div>

    <main class="stage" id="main">
        <h1 class="title" data-title>Dayne.online</h1>
        <p class="tagline"><span data-type>Coming soon</span><span class="caret" aria-hidden="true"></span></p>
    </main>

    <div class="hud">
        <span class="hud-tl">Photographs + writing</span>
        <span class="hud-tr" aria-hidden="true">Sys <span data-clock>00:00:00</span></span>
        <nav class="hud-br" aria-label="Elsewhere">
            <!-- TODO: real Instagram URL and email address -->
            <a href="#">Instagram</a>
            <a href="#">Email</a>
        </nav>
    </div>

    <script is:inline defer src="/assets/js/landing.js"></script>
</body>
</html>
