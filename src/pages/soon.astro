---
// Temporary landing page (brutalist / striped type). Standalone on purpose:
// it does not use Base.astro, so it carries none of the site's header,
// menu, transitions or GSAP stack. Styling lives in /assets/css/landing.css
// and motion in /assets/js/landing.js: a counter, then one giant looping
// line of heavy type cut into horizontal bars (after the IBM 8-bar logo).
// Scrolling drives the line sideways and shears the bars apart.
// The real text stays in the DOM for screen readers and no-JS.
// The favicon (/assets/img/logo.svg) is a still of the box-camera logo.
// To make it live, render this page as the home page.
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>dayne.online</title>
    <meta name="description" content="Photographs and writing by Dayne. Coming soon." />
    <meta name="robots" content="noindex" />
    <meta property="og:title" content="dayne.online" />
    <meta property="og:description" content="Photographs and writing by Dayne. Coming soon." />
    <link rel="icon" href="/assets/img/logo.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#ffffff" />

    <script is:inline>
    (function () {
        var d = document.documentElement;
        d.classList.add("js");
        // Safety net: if landing.js never boots, fall back to the static page.
        setTimeout(function () { if (!window.__landing) d.classList.remove("js"); }, 3000);
    })();
    </script>

    <link rel="preload" href="/assets/fonts/archivo-normal-100-900.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/assets/css/fonts.css" />
    <link rel="stylesheet" href="/assets/css/landing.css" />
</head>
<body>
    <canvas class="screen" aria-hidden="true" data-screen></canvas>

    <div class="counter" aria-hidden="true" data-pct>000</div>
    <div class="negative" aria-hidden="true" data-negative></div>

    <main class="stage" id="main">
        <h1 class="title">dayne.online</h1>
        <p class="line">Coming soon</p>
    </main>

    <nav class="links" aria-label="Elsewhere">
        <!-- TODO: real Instagram URL and email address -->
        <a href="#">Instagram</a>
        <a href="#">Email</a>
    </nav>

    <script is:inline defer src="/assets/js/landing.js"></script>
</body>
</html>
